<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PSDojo.TeamReportRow</Name>
      <ViewSelectedBy>
        <TypeName>PSDojo.TeamReportRow</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Learner</Label></TableColumnHeader>
          <TableColumnHeader><Label>Done</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Total</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Percent</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Attempts</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Hints</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Solutions</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Hours</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Generated</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Learner</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Completed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Total</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Percent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Attempts</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Hints</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SolutionsViewed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Hours</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Generated</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSDojo.TeamModuleRow</Name>
      <ViewSelectedBy>
        <TypeName>PSDojo.TeamModuleRow</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Learner</Label></TableColumnHeader>
          <TableColumnHeader><Label>Module</Label></TableColumnHeader>
          <TableColumnHeader><Label>Done</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Total</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Attempts</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Hints</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Solutions</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Minutes</Label><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Learner</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Module</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Completed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Total</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Attempts</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Hints</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SolutionsViewed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Minutes</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSDojo.ProgressRow</Name>
      <ViewSelectedBy>
        <TypeName>PSDojo.ProgressRow</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Module</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Attempts</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Hints</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Module</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Attempts</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Hints</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSDojo.ReviewItem</Name>
      <ViewSelectedBy>
        <TypeName>PSDojo.ReviewItem</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>LastAction</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reviewer</Label></TableColumnHeader>
          <TableColumnHeader><Label>Timestamp</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LastAction</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Reviewer</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Timestamp</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
