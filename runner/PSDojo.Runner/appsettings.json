{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://127.0.0.1:5081",
  "Runner": {
    "SharedSecret": "",
    "ContentPath": "../../content",
    "Image": "psdojo-runner:latest",
    "DockerPath": "docker",
    "WorkRoot": "",
    "TimeoutSeconds": 15,
    "MemoryMb": 384,
    "Cpus": "1.0",
    "PidsLimit": 128,
    "TmpfsMb": 32,
    "OutputLimitBytes": 65536,
    "MaxCodeBytes": 100000,
    "MaxConcurrent": 4,
    "QueueSeconds": 10
  }
}
