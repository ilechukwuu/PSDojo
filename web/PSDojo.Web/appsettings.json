{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Content": {
    "Path": "../../content"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=App_Data/psdojo.db"
  },
  "Auth": {
    "Provider": "Name",
    "Admins": [],
    "EntraId": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc",
      "RoleClaim": "roles"
    }
  },
  "BrowserExecution": {
    "Mode": "Off",
    "Locked": false,
    "AllowList": []
  },
  "Review": {
    "AllowSameReviewer": false
  },
  "Runner": {
    "Url": "",
    "SharedSecret": "",
    "TimeoutSeconds": 30,
    "RunsPerMinute": 10
  }
}
